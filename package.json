{
  "name": "webenv",
  "version": "0.0.1",
  "description": "The fully-static, git based CMS.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./types": {
      "types": "./src/types/index.d.ts",
      "default": "./src/types/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "eslint": "^10.4.1"
  },
  "workspaces": [
    ".",
    "playground"
  ],
  "overrides": {
    "webenv": "file:."
  }
}
