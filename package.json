{
  "name": "forgepress",
  "type": "module",
  "version": "0.0.1",
  "description": "Fully static, git based CMS.",
  "license": "MIT",
  "sideEffects": false,
  "imports": {
    "#content-source": {
      "node": "./dist/disk/source.mjs",
      "default": "./dist/store/bundle.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "default": "./dist/unplugin.mjs"
    },
    "./editor": {
      "types": "./dist/editor/index.d.mts",
      "default": "./dist/editor/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && pnpm --filter=playground-nuxt run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "obuild && pnpm run build:editor",
    "build:editor": "vite build --config vite.editor.config.mjs",
    "dev:editor": "vite build --config vite.editor.config.mjs --watch",
    "dev:nuxt": "pnpm --filter=playground-nuxt run dev"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/ui": "^4.11.1",
    "@tanstack/vue-table": "^8.21.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.3",
    "obuild": "^0.4.39",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
