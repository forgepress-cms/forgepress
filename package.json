{
  "name": "webenv",
  "version": "0.0.1",
  "description": "The fully-static, git based CMS.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./unplugin": {
      "types": "./src/unplugin.ts",
      "default": "./src/unplugin.ts"
    },
    "./editor": {
      "types": "./dist/editor/index.d.mts",
      "default": "./dist/editor/index.mjs"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && bun --filter=playground-nuxt run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "obuild",
    "dev:nuxt": "bun --filter=playground-nuxt run dev"
  },
  "workspaces": [
    ".",
    "playgrounds/*"
  ],
  "dependencies": {
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.5.0",
    "obuild": "^0.4.36",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.38"
  }
}
